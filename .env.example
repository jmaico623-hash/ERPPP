# ============================================================
# NanoBanana ERP - variáveis de ambiente (copie para .env)
# ============================================================

# Banco de dados PostgreSQL (docker-compose / produção)
DB_NAME=nanobanana
DB_USER=nano
DB_PASS=troque-esta-senha-forte

# Super administrador (obrigatório em produção)
ADMIN_EMAIL=admin@nanobanana.co.mz
ADMIN_PASSWORD=troque-esta-senha-forte

# Cookies exigem HTTPS. Em produção use true.
SESSION_COOKIE_SECURE=false

# Senha do pgAdmin (perfil tools)
PGADMIN_EMAIL=admin@nanobanana.local
PGADMIN_PASSWORD=troque-esta-senha-forte

# Assinatura e suporte
APP_SUBSCRIPTION_PRICE=350.00
APP_MPESA_NUMBER=856810532
APP_EMOLA_NUMBER=863237473
APP_WHATSAPP_NUMBER=863237473
